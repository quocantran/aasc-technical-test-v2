# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_NAME=tiktok-bitrix-sync
APP_SECRET=supersecret-dev-key-change-in-production
API_PREFIX=api/v1
API_KEY=aasc-secure-api-key-2026

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/tiktok_bitrix_db?schema=public

# ==============================================================================
# Redis & BullMQ Configuration
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ==============================================================================
# TikTok Webhook & Integration Configuration
# ==============================================================================
TIKTOK_SECRET_TOKEN=tiktok_secret_token_12345
TIKTOK_APP_ID=7123456789
USE_MOCK_TIKTOK_EVENTS=true
TIKTOK_EVENTS_API_URL=https://business-api.tiktok.com/open_api/v1.3/event/track/
TIKTOK_EVENTS_ACCESS_TOKEN=mock_tiktok_events_token
TIKTOK_PIXEL_CODE=mock_pixel_code

# ==============================================================================
# Bitrix24 CRM Configuration
# ==============================================================================
BITRIX_WEBHOOK_URL=https://b24-sample.bitrix24.vn/rest/1/sampletoken123

# Bitrix24 Outbound Webhook Application Token (verifies ONCRMDEALUPDATE events).
BITRIX_INBOUND_WEBHOOK_SECRET=
USE_MOCK_BITRIX=true
BITRIX_RATE_LIMIT_RPS=2
BITRIX_MAX_RETRIES=3

# ==============================================================================
# Queue & Worker Settings
# ==============================================================================
QUEUE_CONCURRENCY=5
DLQ_MAX_ATTEMPTS=5
AUTO_RETRY_DELAY_MS=1000

# ==============================================================================
# Logging Configuration (Pino)
# ==============================================================================
LOG_LEVEL=debug
PRETTY_LOGS=true
