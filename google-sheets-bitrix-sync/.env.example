# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=data/database.sqlite

# Bitrix24 Authentication Strategy: WEBHOOK | OAUTH2
BITRIX_AUTH_TYPE=WEBHOOK

# Bitrix24 Webhook Configuration (Active when BITRIX_AUTH_TYPE=WEBHOOK)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.vn/rest/1/webhook_token/
BITRIX_RATE_LIMIT_RPS=2
BITRIX_MAX_RETRIES=3

# Bitrix24 OAuth 2.0 Configuration (Active when BITRIX_AUTH_TYPE=OAUTH2)
# Standard Local Application format
# Tokens are auto-persisted and refreshed in SQLite (data/database.sqlite) via POST /install
BITRIX24_CLIENT_ID=your_bitrix24_client_id_here
BITRIX24_CLIENT_SECRET=your_bitrix24_client_secret_here
BITRIX24_DEFAULT_DOMAIN=your-domain.bitrix24.vn
BITRIX24_OAUTH_URL=https://oauth.bitrix.info/oauth/token/
BITRIX24_API_TIMEOUT=10000

# Bitrix24 Inbound Webhook Token (For verifying Outbound Webhooks from Bitrix24 to our server)
BITRIX_INBOUND_WEBHOOK_SECRET=your_bitrix_webhook_auth_token

# Google Sheets Authentication Strategy: SERVICE_ACCOUNT | OAUTH2
GOOGLE_AUTH_TYPE=SERVICE_ACCOUNT

# Google Sheets Service Account Configuration (Active when GOOGLE_AUTH_TYPE=SERVICE_ACCOUNT)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Leads
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/credentials.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=sync-service@project.iam.gserviceaccount.com

# Google Sheets OAuth 2.0 Configuration (Active when GOOGLE_AUTH_TYPE=OAUTH2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Synchronization Configuration
SYNC_DIRECTION=TWO_WAY
SYNC_CRON=*/15 * * * *
SYNC_BATCH_SIZE=50
SYNC_MAPPING_PATH=./config/mapping.json
SYNC_MUTEX_TIMEOUT_MS=300000
